NODE_ENV=development
PORT=3000
CLIENT_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=5432
DB_NAME=auth_app
DB_USER=auth_user
DB_PASSWORD=change-me
DB_POOL_MAX=10

# At least 32 random characters. Do not reuse this placeholder.
SESSION_SECRET=replace-with-at-least-32-random-characters

# Optional. Defaults are 8 hours, 10 attempts, and 15 minutes.
# SESSION_MAX_AGE_MS=28800000
# LOGIN_RATE_LIMIT_MAX=10
# LOGIN_RATE_LIMIT_WINDOW_MS=900000
# TRUST_PROXY=false

# Used only by `npm run create-admin`. Do not put the password in this file.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
